const
    ORION_SIGNALBRIDGEAUTHSTATE_VERSION_MAJOR = 1;
    ORION_SIGNALBRIDGEAUTHSTATE_VERSION_MINOR = 0;
    ORION_SIGNALBRIDGEAUTHSTATE_VERSION_PATCH = 0;
    ORION_SIGNALBRIDGEAUTHSTATE_VERSION_BUILD = 1;

input
    SignalBridgeAuthorizationStateEnabled(True);
    SignalBridgeAuthorizationStateDebug(False);

    AA_MinState(0);
    AA_MaxState(2);

var
    AA_Initialized : Boolean;
    AA_Ready : Boolean;
    AA_Error : Boolean;
    AA_Blocked : Boolean;

    AA_AuthorizationActive : Boolean;
    AA_AuthorizationFresh : Boolean;
    AA_IntegrityValid : Boolean;

    AA_CurrentState : Integer;
    AA_StateValid : Boolean;
    AA_StateApproved : Boolean;

    AA_DecisionAllowed : Boolean;
    AA_EntryAllowed : Boolean;
    AA_ExecutionAllowed : Boolean;

    AA_State : Integer;

begin

    if not AA_Initialized then
    begin
        AA_Initialized := True;

        AA_Ready := False;
        AA_Error := False;
        AA_Blocked := False;

        AA_AuthorizationActive := True;
        AA_AuthorizationFresh := True;
        AA_IntegrityValid := True;

        AA_CurrentState := 0;

        AA_StateValid := False;
        AA_StateApproved := False;

        AA_DecisionAllowed := False;
        AA_EntryAllowed := False;
        AA_ExecutionAllowed := False;

        AA_State := 0;
    end;

    if SignalBridgeAuthorizationStateEnabled then
    begin

        AA_Error := False;
        AA_Blocked := False;

        AA_StateValid := False;
        AA_StateApproved := False;

        if AA_AuthorizationActive then
        begin
            if AA_AuthorizationFresh then
            begin
                if AA_IntegrityValid then
                begin
                    if AA_CurrentState >= AA_MinState then
                    begin
                        if AA_CurrentState <= AA_MaxState then
                        begin
                            AA_StateValid := True;
                        end;
                    end;
                end;
            end;
        end;

        if AA_StateValid then
        begin
            AA_StateApproved := True;

            AA_DecisionAllowed := True;
            AA_EntryAllowed := True;

            AA_Blocked := False;
            AA_State := 1;
        end
        else
        begin
            AA_StateApproved := False;

            AA_DecisionAllowed := False;
            AA_EntryAllowed := False;

            AA_Error := True;
            AA_Blocked := True;
            AA_State := 2;
        end;

        AA_Ready := True;

        AA_ExecutionAllowed := False;

    end
    else
    begin
        AA_Ready := False;
        AA_Blocked := True;

        AA_StateApproved := False;

        AA_DecisionAllowed := False;
        AA_EntryAllowed := False;
        AA_ExecutionAllowed := False;

        AA_State := 2;
    end;

    if SignalBridgeAuthorizationStateDebug then
    begin
        Plot(AA_State);
    end;

end;
