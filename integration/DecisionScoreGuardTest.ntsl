const
    DS_MIN_SCORE = 70;
    DS_TREND_WEIGHT = 40;
    DS_SIGNAL_WEIGHT = 35;
    DS_RISK_WEIGHT = 25;

var
    DS_Initialized : Boolean;
    DS_Ready : Boolean;
    DS_Blocked : Boolean;
    DS_Error : Boolean;

    DS_TrendScore : Float;
    DS_SignalScore : Float;
    DS_RiskScore : Float;

    DS_FinalScore : Float;
    DS_WeightTotal : Float;

    DS_Allowed : Boolean;
    DS_State : Integer;

begin

    if not DS_Initialized then
    begin
        DS_Initialized := True;
        DS_Ready := False;
        DS_Blocked := False;
        DS_Error := False;

        DS_TrendScore := 0;
        DS_SignalScore := 0;
        DS_RiskScore := 0;

        DS_FinalScore := 0;
        DS_WeightTotal := 0;

        DS_Allowed := False;
        DS_State := 0;
    end;

    DS_Error := False;
    DS_Blocked := False;

    DS_WeightTotal :=
        DS_TREND_WEIGHT +
        DS_SIGNAL_WEIGHT +
        DS_RISK_WEIGHT;

    if DS_WeightTotal <= 0 then
    begin
        DS_Error := True;
        DS_Blocked := True;
        DS_Allowed := False;
        DS_FinalScore := 0;
        DS_State := 2;
    end
    else
    begin

        DS_FinalScore :=
            (
                DS_TrendScore * DS_TREND_WEIGHT +
                DS_SignalScore * DS_SIGNAL_WEIGHT +
                DS_RiskScore * DS_RISK_WEIGHT
            ) / DS_WeightTotal;

        if DS_FinalScore >= DS_MIN_SCORE then
        begin
            DS_Allowed := True;
            DS_Blocked := False;
            DS_State := 1;
        end
        else
        begin
            DS_Allowed := False;
            DS_Blocked := True;
            DS_State := 2;
        end;

    end;

    DS_Ready := True;

    Plot(DS_FinalScore);

end;
