const
    ORION_EXECUTIONRISKLIMIT_VERSION_MAJOR = 1;
    ORION_EXECUTIONRISKLIMIT_VERSION_MINOR = 0;
    ORION_EXECUTIONRISKLIMIT_VERSION_PATCH = 0;
    ORION_EXECUTIONRISKLIMIT_VERSION_BUILD = 1;

input
    ExecutionRiskLimitGuardEnabled(True);
    ExecutionRiskLimitGuardDebug(False);

    ER_MinContracts(1);
    ER_MaxContracts(3);
    ER_MaxRiskPoints(300);

var
    ER_Initialized : Boolean;
    ER_Ready : Boolean;
    ER_Error : Boolean;
    ER_Blocked : Boolean;

    ER_Contracts : Integer;
    ER_RiskPoints : Float;

    ER_ContractsValid : Boolean;
    ER_RiskValid : Boolean;
    ER_LimitValid : Boolean;
    ER_RiskApproved : Boolean;

    ER_DecisionAllowed : Boolean;
    ER_EntryAllowed : Boolean;
    ER_OrderApproved : Boolean;
    ER_ExecutionAllowed : Boolean;

    ER_State : Integer;

begin

    if not ER_Initialized then
    begin
        ER_Initialized := True;

        ER_Ready := False;
        ER_Error := False;
        ER_Blocked := False;

        ER_Contracts := 0;
        ER_RiskPoints := 0;

        ER_ContractsValid := False;
        ER_RiskValid := False;
        ER_LimitValid := False;
        ER_RiskApproved := False;

        ER_DecisionAllowed := False;
        ER_EntryAllowed := False;
        ER_OrderApproved := False;
        ER_ExecutionAllowed := False;

        ER_State := 0;
    end;

    if ExecutionRiskLimitGuardEnabled then
    begin

        ER_Error := False;
        ER_Blocked := False;

        ER_ContractsValid := False;
        ER_RiskValid := False;
        ER_LimitValid := False;
        ER_RiskApproved := False;

        if ER_Contracts >= ER_MinContracts then
        begin
            if ER_Contracts <= ER_MaxContracts then
            begin
                ER_ContractsValid := True;
            end;
        end;

        if ER_RiskPoints >= 0 then
        begin
            if ER_RiskPoints <= ER_MaxRiskPoints then
            begin
                ER_RiskValid := True;
            end;
        end;

        if ER_ContractsValid and ER_RiskValid then
        begin
            ER_LimitValid := True;
        end;

        if ER_LimitValid then
        begin
            ER_RiskApproved := True;
        end;

        if ER_RiskApproved then
        begin
            ER_DecisionAllowed := True;
            ER_EntryAllowed := True;
            ER_OrderApproved := True;
            ER_Blocked := False;

            ER_State := 1;
        end
        else
        begin
            ER_Error := True;
            ER_Blocked := True;

            ER_DecisionAllowed := False;
            ER_EntryAllowed := False;
            ER_OrderApproved := False;

            ER_State := 2;
        end;

        ER_Ready := True;

        ER_ExecutionAllowed := False;

    end
    else
    begin
        ER_Ready := False;
        ER_Blocked := True;

        ER_DecisionAllowed := False;
        ER_EntryAllowed := False;
        ER_OrderApproved := False;
        ER_ExecutionAllowed := False;

        ER_State := 2;
    end;

    if ExecutionRiskLimitGuardDebug then
    begin
        Plot(ER_State);
    end;

end;
