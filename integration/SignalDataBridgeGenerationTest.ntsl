const
    ORION_SIGNALBRIDGEGENERATION_VERSION_MAJOR = 1;
    ORION_SIGNALBRIDGEGENERATION_VERSION_MINOR = 0;
    ORION_SIGNALBRIDGEGENERATION_VERSION_PATCH = 0;
    ORION_SIGNALBRIDGEGENERATION_VERSION_BUILD = 1;

input
    SignalBridgeGenerationEnabled(True);
    SignalBridgeGenerationDebug(False);

var
    SG_Initialized : Boolean;
    SG_Ready : Boolean;
    SG_Error : Boolean;
    SG_Blocked : Boolean;

    SG_Generation : Integer;

    SG_GenerationValid : Boolean;
    SG_GenerationApproved : Boolean;

    SG_DecisionAllowed : Boolean;
    SG_EntryAllowed : Boolean;
    SG_ExecutionAllowed : Boolean;

    SG_State : Integer;

begin

    if not SG_Initialized then
    begin
        SG_Initialized := True;

        SG_Ready := False;
        SG_Error := False;
        SG_Blocked := False;

        SG_Generation := 0;

        SG_GenerationValid := False;
        SG_GenerationApproved := False;

        SG_DecisionAllowed := False;
        SG_EntryAllowed := False;
        SG_ExecutionAllowed := False;

        SG_State := 0;
    end;

    if SignalBridgeGenerationEnabled then
    begin

        SG_Error := False;
        SG_Blocked := False;

        SG_GenerationValid := False;
        SG_GenerationApproved := False;

        if SG_Generation >= 0 then
        begin
            SG_GenerationValid := True;
        end;

        if SG_GenerationValid then
        begin
            SG_GenerationApproved := True;

            SG_DecisionAllowed := True;
            SG_EntryAllowed := True;

            SG_Blocked := False;
            SG_State := 1;
        end
        else
        begin
            SG_GenerationApproved := False;

            SG_DecisionAllowed := False;
            SG_EntryAllowed := False;

            SG_Error := True;
            SG_Blocked := True;
            SG_State := 2;
        end;

        SG_Ready := True;

        SG_ExecutionAllowed := False;

    end
    else
    begin
        SG_Ready := False;
        SG_Blocked := True;

        SG_GenerationApproved := False;

        SG_DecisionAllowed := False;
        SG_EntryAllowed := False;
        SG_ExecutionAllowed := False;

        SG_State := 2;
    end;

    if SignalBridgeGenerationDebug then
    begin
        Plot(SG_State);
    end;

end;
