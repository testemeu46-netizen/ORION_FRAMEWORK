const
    ORION_DIRECTION_VERSION_MAJOR = 1;
    ORION_DIRECTION_VERSION_MINOR = 0;
    ORION_DIRECTION_VERSION_PATCH = 0;
    ORION_DIRECTION_BUILD = 1;

input
    DirectionGuardEnabled(True);
    DirectionGuardDebug(False);

    DG_MinScore(70);

var
    DG_Initialized : Boolean;
    DG_Ready : Boolean;
    DG_Error : Boolean;
    DG_Blocked : Boolean;

    DG_CurrentBar : Integer;
    DG_LastBar : Integer;
    DG_Cycle : Integer;

    DG_Score : Float;
    DG_Direction : Integer;

    DG_DirectionValid : Boolean;
    DG_ScoreValid : Boolean;
    DG_Consistent : Boolean;

    DG_DecisionAllowed : Boolean;
    DG_EntryAllowed : Boolean;
    DG_ExecutionAllowed : Boolean;

    DG_State : Integer;

begin

    if not DG_Initialized then
    begin
        DG_Initialized := True;

        DG_Ready := False;
        DG_Error := False;
        DG_Blocked := False;

        DG_CurrentBar := CurrentBar;
        DG_LastBar := CurrentBar;
        DG_Cycle := 0;

        DG_Score := 0;
        DG_Direction := 0;

        DG_DirectionValid := False;
        DG_ScoreValid := False;
        DG_Consistent := False;

        DG_DecisionAllowed := False;
        DG_EntryAllowed := False;
        DG_ExecutionAllowed := False;

        DG_State := 0;
    end;

    DG_CurrentBar := CurrentBar;

    if DirectionGuardEnabled then
    begin

        if DG_CurrentBar <> DG_LastBar then
        begin
            DG_Cycle := DG_Cycle + 1;
            DG_LastBar := DG_CurrentBar;
        end;

        DG_Error := False;
        DG_Blocked := False;

        DG_DirectionValid := False;
        DG_ScoreValid := False;
        DG_Consistent := False;

        if DG_Direction >= -1 then
        begin
            if DG_Direction <= 1 then
            begin
                DG_DirectionValid := True;
            end;
        end;

        if DG_Score >= 0 then
        begin
            if DG_Score <= 100 then
            begin
                DG_ScoreValid := True;
            end;
        end;

        if DG_DirectionValid and DG_ScoreValid then
        begin

            if DG_Direction = 0 then
            begin
                DG_Consistent := False;
            end
            else
            begin
                if DG_Score >= DG_MinScore then
                begin
                    DG_Consistent := True;
                end;
            end;

        end;

        if not DG_Consistent then
        begin
            DG_Error := True;
            DG_Blocked := True;

            DG_DecisionAllowed := False;
            DG_EntryAllowed := False;
            DG_ExecutionAllowed := False;

            DG_State := 2;
        end
        else
        begin
            DG_Error := False;
            DG_Blocked := False;

            DG_DecisionAllowed := True;
            DG_EntryAllowed := True;

            /*
               Execução permanece deliberadamente bloqueada
               durante a fase de testes.
            */
            DG_ExecutionAllowed := False;

            DG_State := 1;
        end;

        DG_Ready := True;

    end
    else
    begin
        DG_Ready := False;
        DG_Blocked := True;

        DG_DecisionAllowed := False;
        DG_EntryAllowed := False;
        DG_ExecutionAllowed := False;

        DG_State := 2;
    end;

    if DirectionGuardDebug then
    begin
        Plot(DG_State);
    end;

end;
