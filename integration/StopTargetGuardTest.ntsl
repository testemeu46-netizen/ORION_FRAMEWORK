const
    ORION_STOPTARGET_VERSION_MAJOR = 1;
    ORION_STOPTARGET_VERSION_MINOR = 0;
    ORION_STOPTARGET_VERSION_PATCH = 0;
    ORION_STOPTARGET_VERSION_BUILD = 1;

input
    StopTargetGuardEnabled(True);
    StopTargetGuardDebug(False);

    ST_MinStopPoints(1);
    ST_MinTargetPoints(1);

var
    ST_Initialized : Boolean;
    ST_Ready : Boolean;
    ST_Error : Boolean;
    ST_Blocked : Boolean;

    ST_StopPoints : Float;
    ST_TargetPoints : Float;

    ST_StopValid : Boolean;
    ST_TargetValid : Boolean;
    ST_RelationValid : Boolean;
    ST_Approved : Boolean;

    ST_DecisionAllowed : Boolean;
    ST_EntryAllowed : Boolean;
    ST_ExecutionAllowed : Boolean;

    ST_State : Integer;

begin

    if not ST_Initialized then
    begin
        ST_Initialized := True;

        ST_Ready := False;
        ST_Error := False;
        ST_Blocked := False;

        ST_StopPoints := 0;
        ST_TargetPoints := 0;

        ST_StopValid := False;
        ST_TargetValid := False;
        ST_RelationValid := False;
        ST_Approved := False;

        ST_DecisionAllowed := False;
        ST_EntryAllowed := False;
        ST_ExecutionAllowed := False;

        ST_State := 0;
    end;

    if StopTargetGuardEnabled then
    begin

        ST_Error := False;
        ST_Blocked := False;

        ST_StopValid := False;
        ST_TargetValid := False;
        ST_RelationValid := False;
        ST_Approved := False;

        if ST_StopPoints >= ST_MinStopPoints then
        begin
            ST_StopValid := True;
        end;

        if ST_TargetPoints >= ST_MinTargetPoints then
        begin
            ST_TargetValid := True;
        end;

        if ST_StopValid and ST_TargetValid then
        begin
            if ST_TargetPoints >= ST_StopPoints then
            begin
                ST_RelationValid := True;
            end;
        end;

        if ST_StopValid and ST_TargetValid then
        begin
            if ST_RelationValid then
            begin
                ST_Approved := True;
            end;
        end;

        if ST_Approved then
        begin
            ST_DecisionAllowed := True;
            ST_EntryAllowed := True;
            ST_Blocked := False;

            ST_State := 1;
        end
        else
        begin
            ST_Error := True;
            ST_Blocked := True;

            ST_DecisionAllowed := False;
            ST_EntryAllowed := False;

            ST_State := 2;
        end;

        ST_Ready := True;

        ST_ExecutionAllowed := False;

    end
    else
    begin
        ST_Ready := False;
        ST_Blocked := True;

        ST_DecisionAllowed := False;
        ST_EntryAllowed := False;
        ST_ExecutionAllowed := False;

        ST_State := 2;
    end;

    if StopTargetGuardDebug then
    begin
        Plot(ST_State);
    end;

end;
